# =============================================================
# .env.docker.example — Plantilla de variables para Docker
# =============================================================
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.docker.example .env.docker
# 2. Rellena TODOS los valores (sin comillas en los valores)
# 3. El archivo .env.docker NUNCA se sube a Git
# =============================================================

# ----------------------------------------------------------
# Supabase (backend)
# ----------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key

# ----------------------------------------------------------
# Supabase (frontend — variables VITE, usadas en build-time)
# ----------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ----------------------------------------------------------
# URLs de la API (frontend)
# DEV:  http://localhost:8000
# PROD: http://<IP-o-dominio-del-servidor>:8000
# ----------------------------------------------------------
VITE_API_URL=http://localhost:8000

# ----------------------------------------------------------
# Backend — CORS (orígenes permitidos, separados por coma)
# DEV:  http://localhost:5173,http://127.0.0.1:5173
# PROD: http://<IP-o-dominio-del-servidor>
# ----------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ----------------------------------------------------------
# Google Cloud (opcional si no usás Vertex AI)
# ----------------------------------------------------------
GCP_PROJECT_ID=

# ----------------------------------------------------------
# Google AI — Gemini API
# ----------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=tu-google-api-key

# ----------------------------------------------------------
# Email SMTP — Backend (Recordatorios de tareas)
# ----------------------------------------------------------
EMAIL_SENDER=tu-email@gmail.com
EMAIL_PASSWORD=tu-app-password-de-gmail
